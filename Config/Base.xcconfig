// Settings shared by every target. Signing is personal, so it lives in
// Signing.local.xcconfig, which git ignores. To build on a device, copy
// Signing.local.xcconfig.example to Signing.local.xcconfig and fill it in.

// prefix for the app and test bundle identifiers
BUNDLE_ID_PREFIX = io.github.amadesa

// your Apple developer team (Xcode > Settings > Accounts)
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
