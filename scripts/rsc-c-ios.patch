diff -ruN -x gl -x pica -x wii -x mudclient-sdl*.c -x mudclient-wii.c -x mudclient-3ds.c -x *-gl.c -x rsa-openssl.c a/mudclient-ios.c b/mudclient-ios.c
--- a/mudclient-ios.c	1969-12-31 18:00:00
