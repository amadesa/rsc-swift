+
+    surface_draw_border(mud->surface, x, y, KEYBOARD_BUTTON_WIDTH,
+                        KEYBOARD_BUTTON_HEIGHT, WHITE);
+
+    surface_draw_string_centre(mud->surface, "Chat",
