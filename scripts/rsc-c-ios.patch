+    /* RSCPlus flashes under 30% hits or prayer, and from 80% fatigue */
+    draw_docked_bar(mud, x, y, bar_width, 0x00d200,
+                    max_hits > 0 && hits * 100 / max_hits < 30, hits,
+                    max_hits);
