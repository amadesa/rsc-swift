			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Level up</string>
			<key>Key</key>
			<string>alert_level_up</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Private messages, trades and duels</string>
			<key>Key</key>
			<string>alert_messages</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
